# Backend-only Gemini Developer API settings. Copy to ignored .env and edit locally.
# Never put this key in chat, VITE_* variables, browser code, or job configuration.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GUIDE2BUILD_DATA_DIR=var
# Backend-only Gradium key for BrickBuddy voice (speech-to-text and text-to-speech).
# The browser only receives single-use tokens from POST /api/v1/voice/token.
# GRADIUM_API_KEY=
# Optional voice, default Emma (en-US):
# GRADIUM_VOICE_ID=YTpq7expH9539ERJ
# The local engine defaults to google_adk / gemini-3.8-flash / medium.
# Model, thinking level, timeout, and budget are frozen per explicit CLI job.
# Starting the web/API/worker or running CI does not invoke Gemini.
# Optional: BrickBuddy chat model (default gemini-3.8-flash) and a Gradium endpoint override.
# BRICKVISIONX_CHAT_MODEL=
# GRADIUM_BASE_URL=
# BRICKVISIONX_CHAT_MAX_REPLIES=300   # paid BrickBuddy replies per API process
